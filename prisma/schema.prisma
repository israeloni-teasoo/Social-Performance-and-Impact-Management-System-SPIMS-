generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  /// The pooled connection the application uses. On serverless this must point at the
  /// provider's transaction pooler, or connections outlive the invocations that made
  /// them and the database runs out.
  url = env("DATABASE_URL")
  /// A direct connection, used only for migrations. Schema changes cannot run through
  /// a transaction pooler. Falls back to DATABASE_URL when unset, which is correct for
  /// a self-hosted install where the two are the same.
  directUrl = env("DIRECT_URL")
}

enum Role {
  exec
  manager
  field
  relations
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  roleLabel    String
  initials     String
  /// Accounts are deactivated rather than deleted: a user is referenced by the
  /// comments they wrote and the uploads they made, and that history must survive
  /// someone leaving.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  approvalComments ApprovalComment[]
  reportComments   ReportComment[]
  bulkUploads      BulkUpload[]
}

model Project {
  id       String @id
  code     String @unique
  name     String
  output   String
  pillar   String
  state    String
  budget   String
  utilPct  String
  progress String
  progPct  String
  status   String

  /// Operational detail captured when a project is set up. Optional because the
  /// programmes seeded from Seplat's published report predate the intake form.
  startDate     String?
  endDate       String?
  fundingSource String?
  contractor    String?
  partner       String?
  community     String?
  lga           String?
  owner         String?

  impact       ProjectImpact?
  fieldTasks   FieldTask[]
  spendEntries SpendEntry[]
  customFields CustomField[]
  mentions     Mention[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectImpact {
  id          String  @id @default(cuid())
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String  @unique
  projectCode String

  inputs              String
  activities          String
  outputHeadline      String
  outcome             String
  reach               Json? // ReachProfile — interactions vs. people actually served
  impactHeadline      String
  impactFigure        String
  impactFigureLabel   String
  impactPoints        Json // string[]
  methodology         Json // { metric, calculation, source, note }
  impactScenarios     Json? // ImpactScenario[]
  impactScenarioBasis String?
  baseline            Json // BaselinePoint[]
  baselineCaption     String
  dualLens            Json // DualLensTag[]
  costPerOutcome      String
  sroi                String
  contactPerson       String
  communitiesImpacted Json // string[]
}

model Community {
  id       String @id
  name     String
  lga      String
  state    String
  pop      String
  projects Int
  spend    String
  cdc      String
}

model Indicator {
  id     String @id
  metric String
  local  String
  global String
  sdg    String
}

model Report {
  id      String @id
  name    String
  lens    String
  desc    String
  updated String

  comments ReportComment[]
}

model ReportComment {
  id                 String   @id @default(cuid())
  report             Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId           String
  author             User     @relation(fields: [authorId], references: [id])
  authorId           String
  text               String
  requestsCorrection Boolean  @default(false)
  createdAt          DateTime @default(now())
}

model Stakeholder {
  id          String @id @default(cuid())
  name        String
  type        String
  community   String
  engagements Int
  commitments String
  status      String
}

model FieldTask {
  id           String      @id @default(cuid())
  title        String
  project      Project?    @relation(fields: [projectId], references: [id])
  projectId    String?
  projectLabel String
  due          String
  dueColor     String
  assignee     TeamMember? @relation(fields: [assigneeId], references: [id])
  assigneeId   String?
  status       String      @default("Not started")
  createdBy    String?
  createdAt    DateTime    @default(now())
}

model TeamMember {
  id        String      @id @default(cuid())
  name      String
  email     String
  roleTitle String
  status    String      @default("Active")
  joinedAt  String
  tasks     FieldTask[]
}

model Approval {
  id       String            @id @default(cuid())
  who      String
  item     String
  project  String
  when     String
  type     String
  details  Json // string[]
  status   String            @default("Pending")
  comments ApprovalComment[]
}

model ApprovalComment {
  id         String   @id @default(cuid())
  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  approvalId String
  author     User     @relation(fields: [authorId], references: [id])
  authorId   String
  text       String
  createdAt  DateTime @default(now())
}

model EvidenceItem {
  id    String @id @default(cuid())
  label String
  meta  String
  kind  String
}

model Target {
  id           String   @id @default(cuid())
  name         String
  metric       String
  unit         String
  periodStart  String
  periodEnd    String
  totalTarget  Float
  currentValue Float
  status       String   @default("Active")
  createdAt    DateTime @default(now())
}

model SpendEntry {
  id            String   @id @default(cuid())
  project       Project  @relation(fields: [projectId], references: [id])
  projectId     String
  periodMonth   String
  pillar        String
  amountNgn     Float
  fundingSource String
  notes         String?
  createdAt     DateTime @default(now())
}

model BulkUpload {
  id           String   @id @default(cuid())
  filename     String
  dataType     String
  projectId    String?
  rowCount     Int
  status       String   @default("Received")
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById String
  createdAt    DateTime @default(now())
}

/// A question a programme keeps getting asked, answered on the programme's own page.
model CustomField {
  id          String  @id @default(cuid())
  project     Project @relation(fields: [projectCode], references: [code], onDelete: Cascade)
  projectCode String

  question  String
  answer    String
  format    String // text | number | percent | naira | date
  source    String
  updatedBy String
  updatedAt String

  createdAt DateTime @default(now())

  @@index([projectCode])
}

/// Organisation-level settings. A single row (id "org") rather than a key/value table,
/// so the shape is typed and a missing setting is impossible.
model OrgSettings {
  id             String   @id @default("org")
  orgName        String   @default("Seplat Energy Plc")
  financialYear  String   @default("FY 2026")
  currencyLabel  String   @default("\u20a6 Naira")
  targetYear     Int      @default(2030)
  /// Shown on the sign-in screen and in exports, so a deployment can state whether it
  /// holds live data or sample data.
  dataStatusNote String   @default("Illustrative data \u2014 replace with verified Seplat figures before external reporting.")
  updatedAt      DateTime @updatedAt
}

/// A place SPIMS looks for mentions of Seplat and its programmes.
///
/// Phase one carries only free sources — GDELT's article index, an outlet's own RSS
/// feed, and a Google Alerts feed. Each is reached through the same adapter interface,
/// so adding a paid provider later is a new `kind`, not a new module.
model MentionSource {
  id     String  @id @default(cuid())
  name   String
  /// gdelt | rss | googleAlerts
  kind   String
  /// For gdelt, the search query. For the feed kinds, the feed URL.
  target String
  /// A source is configured before it is switched on, so a bad query cannot start
  /// filling the queue with noise before anyone has looked at it.
  active Boolean @default(true)

  mentions Mention[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, target])
}

/// One article that mentions Seplat, awaiting or having had human review.
///
/// Nothing here is reported as a Seplat figure. A mention is evidence that someone
/// wrote something, which is a different kind of claim from the counted figures in the
/// analytics layer, and the two are deliberately not mixed.
model Mention {
  id       String        @id @default(cuid())
  source   MentionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId String

  /// The article URL, normalised. Unique, because the same story reaches us from
  /// several sources and the queue must not show it twice.
  url         String    @unique
  title       String
  publisher   String
  snippet     String    @default("")
  language    String    @default("")
  country     String    @default("")
  /// When the outlet published it. Null when the source does not say.
  publishedAt DateTime?

  /// pending | accepted | rejected
  status      String   @default("pending")
  /// Set on review: socialInvestment | corporate | unrelated
  category    String?
  /// Which programme this mention is about, when it is about one.
  project     Project? @relation(fields: [projectCode], references: [code], onDelete: SetNull)
  projectCode String?

  reviewedBy String?
  reviewedAt DateTime?

  /// Names of the alert rules this mention matched when it was collected, comma
  /// separated. Null means it matched none. Recorded even when no channel is
  /// configured, so the queue can show what would have been alerted on.
  flags String?
  /// When an alert naming this mention was sent. Set on the attempt rather than on a
  /// confirmed delivery — see the at-most-once note in lib/media/alerts.ts.
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([projectCode])
  @@index([publishedAt])
}

/// A watchlist: what makes a mention worth interrupting someone for.
///
/// Separate from the source list on purpose. Sources decide what is collected;
/// rules decide what is urgent. Collecting everything and alerting on everything
/// would train people to ignore the alerts, which is worse than having none.
model AlertRule {
  id String @id @default(cuid())
  /// Shown in the alert, so the reader knows why they were interrupted.
  name String
  /// Terms, one per line or comma separated. Matched case-insensitively against the
  /// headline and the snippet.
  terms  String
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Where an alert is delivered.
///
/// The URL is a credential: anyone holding it can post into that Teams or Slack
/// channel. It is never returned to the browser in full, and only an Executive can
/// add or remove one.
model AlertChannel {
  id String @id @default(cuid())
  name String
  /// teams | slack | webhook
  kind   String
  url    String
  active Boolean @default(true)

  /// The last delivery outcome, so a webhook that has quietly stopped working is
  /// visible on the screen rather than discovered when an alert is missed.
  lastStatus String?
  lastError  String?
  lastSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// What one ingestion run did, so an empty queue can be told from a broken fetch.
model MentionRun {
  id         String   @id @default(cuid())
  startedAt  DateTime @default(now())
  /// ok | partial | failed
  status     String
  /// Per-source outcome, including the error text for any source that failed.
  detail     Json
  found      Int      @default(0)
  added      Int      @default(0)
  duplicates Int      @default(0)
}
