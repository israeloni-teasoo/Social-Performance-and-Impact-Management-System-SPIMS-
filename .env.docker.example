# Copy to .env before running docker compose. Never commit the filled-in file.
#
#   cp .env.docker.example .env
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Database (stays inside the Docker network) ---
POSTGRES_USER=spims
POSTGRES_PASSWORD=
POSTGRES_DB=spims

# --- Session signing ---
# Changing this invalidates every signed-in session. 64 hex characters.
JWT_SECRET=

# --- Claude report generation (optional) ---
# Leave empty to run without it. The Claude preview button then returns a clear
# "not configured" message; nothing else in the app is affected.
# NOTE: setting this means report content is sent to Anthropic's API over the
# internet. See docs/TECHNICAL-SPECIFICATION.md, "Outbound data flows".
ANTHROPIC_API_KEY=

# --- Serving ---
# Port on the host that nginx binds to. Put your own TLS terminator in front.
HTTP_PORT=8080

# Session cookies are marked Secure by default, which means the browser will only
# send them over HTTPS. If you are serving this over plain HTTP on an internal
# network, set this to false or logins will appear to succeed and then drop.
SESSION_COOKIE_SECURE=true

# Load the demo dataset on first start. Demo accounts use passwords published in
# the repository — leave false for any deployment holding real data.
SEED_ON_START=false

# Only needed if the frontend is served from a different origin than the API.
# Comma-separated. Leave empty for the standard single-origin deployment.
CORS_ORIGINS=
