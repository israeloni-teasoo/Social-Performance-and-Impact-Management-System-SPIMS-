# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string. For local dev against the Postgres set up in this
# environment: postgresql://spims:spims_dev_pw@localhost:5432/spims_dev
# For production, use the connection string Neon gives you when you create the database.
DATABASE_URL="postgresql://spims:spims_dev_pw@localhost:5432/spims_dev"

# Random string used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-random-64-char-hex-string"

# From console.anthropic.com -> API Keys. Required only for the Claude-generated
# report preview endpoint (/api/reports/generate-preview) -- everything else works
# without it.
ANTHROPIC_API_KEY=""

# Port the local dev API server listens on (server/devServer.ts). The frontend's
# Vite dev server proxies /api/* to this port -- see frontend/vite.config.ts.
API_PORT=8787
