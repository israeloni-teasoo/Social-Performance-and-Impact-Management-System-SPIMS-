# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---------------------------------------------------------------
# The connection the application uses.
#
# Self-hosted: one Postgres, one connection string, and DIRECT_URL can be left unset.
#   postgresql://spims:spims_dev_pw@localhost:5432/spims_dev
#
# Serverless (Vercel): this MUST be the provider's pooled connection, or connections
# outlive the invocations that opened them and the database runs out of them under
# load. Supabase uses port 6543; Neon uses a "-pooler" host.
#   postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://spims:spims_dev_pw@localhost:5432/spims_dev"

# A direct (unpooled) connection, used only for migrations — schema changes cannot run
# through a transaction pooler. Leave unset when it is the same as DATABASE_URL.
#   postgresql://USER:PASS@HOST:5432/postgres
DIRECT_URL=""

# --- Sessions ---------------------------------------------------------------
# Random string used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-random-64-char-hex-string"

# Whether the session cookie carries the Secure flag. Defaults to on in production,
# which is correct for anything served over HTTPS, including Vercel. Set to "false"
# only for an internal install served over plain HTTP — otherwise the browser drops
# the cookie and every login looks like a wrong password.
# SESSION_COOKIE_SECURE="true"

# --- Optional integrations --------------------------------------------------
# From console.anthropic.com -> API Keys. Required only for the Claude-generated
# report preview endpoint (/api/reports/generate-preview) -- everything else works
# without it.
ANTHROPIC_API_KEY=""

# Shared secret for scheduled media-mention collection. Vercel sends it as
# "Authorization: Bearer <value>" when it runs the cron job in vercel.json. The
# endpoint refuses every request when this is unset, so leaving it blank disables
# scheduled collection rather than exposing it. Generate one the same way as
# JWT_SECRET, and set the same value in the Vercel project's environment variables.
CRON_SECRET=""

# How long to wait for one media source before giving up, in milliseconds.
# Default 20000. Lower it if a run is being cut short by the platform's function
# time limit.
# MEDIA_FETCH_TIMEOUT_MS="20000"

# --- Local development ------------------------------------------------------
# Port the local dev API server listens on (server/main.ts). The frontend's
# Vite dev server proxies /api/* to this port -- see frontend/vite.config.ts.
API_PORT=8787
